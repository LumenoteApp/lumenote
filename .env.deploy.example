# FTP settings for "npm run deploy". Copy to .env.deploy and fill in.
# Same details as in FileZilla (Site Manager). .env.deploy is never committed.
FTP_HOST=ftp.lumenote.nl
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# Folder that holds the site, the one you upload to in FileZilla.
FTP_DIR=/domains/lumenote.nl/public_html
# Encrypted FTP (recommended). Set to false only if connecting fails on a certificate error.
FTP_SECURE=true
